# Billing TEST environment. Copy to .env.stripe-test (git-ignored) and fill in TEST values only. Never reuse production values.
# Check it with:  set -a; . ./.env.stripe-test; set +a; node scripts/test-env/check-isolation.mjs

# Stripe TEST mode (ALPA's Stripe account, test side)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME          # printed by `stripe listen`, or the test-mode endpoint's signing secret
STRIPE_STARTER_PRICE_ID=price_REPLACE_ME        # TEST price, same amount/interval as the live Starter plan
STRIPE_PROSPECTOR_PRICE_ID=price_REPLACE_ME     # TEST price, same amount/interval as the live Prospector plan

# Isolated Supabase TEST project (never the production project)
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_WITH_TEST_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Local app
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=any-long-random-test-value
# Leave OPENAI_API_KEY / SERPER_API_KEY / GOOGLE_PLACES_API_KEY unset: no paid provider is needed (guest data is seeded).
