NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_STARTER_PRICE_ID=
STRIPE_PROSPECTOR_PRICE_ID=
CRON_SECRET=
AGENT_DISCOVERY_CONCURRENCY=3
AGENT_DRAFT_CONCURRENCY=2
AGENT_CRON_BATCH_SIZE=10
AGENT_CRON_CONCURRENCY=2

# Optional: recommended for Playwright on Vercel
PLAYWRIGHT_BROWSERS_PATH=0

# Optional: set to v1 to roll back email discovery only (V2 is the default). Server-only.
# EMAIL_INTELLIGENCE_VERSION=

# Optional: override the User-Agent used when reading business websites. Must still identify a
# product and include a public URL; invalid values are ignored. Server-only.
# ALPA_FETCH_USER_AGENT=

# Optional: set to off to stop email discovery from reading robots.txt (default: on). Server-only.
# EMAIL_INTELLIGENCE_ROBOTS=
